{
  "name": "n8n-nodes-postdom",
  "version": "0.4.0",
  "description": "n8n community node for Postdom — agent-led short-form video publishing, bounded plans, and performance measurement.",
  "keywords": [
    "n8n-community-node-package",
    "postdom",
    "social-media",
    "tiktok",
    "instagram-reels",
    "youtube-shorts",
    "ai-agent",
    "schedule",
    "mcp",
    "short-form-video"
  ],
  "license": "MIT",
  "homepage": "https://postdom.com",
  "author": {
    "name": "Blue Venture Studios Pty Ltd",
    "email": "support@postdom.com",
    "url": "https://postdom.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deanfankhauser/n8n-nodes-postdom.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/PostdomApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Postdom/Postdom.node.js",
      "dist/nodes/PostdomTrigger/PostdomTrigger.node.js"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-icons.mjs",
    "lint": "eslint credentials nodes test",
    "test:submission": "node --test submission/package-verification.test.mjs submission/mirror-drift.test.mjs",
    "//test": "The exclude pattern MUST stay quoted. npm runs scripts through sh on Linux and in CI; sh has no globstar, so an unquoted submission/** is expanded by the shell before vitest starts - --exclude swallows the first entry and the remaining seven arrive as positional filters, which makes vitest try to run the two node:test suites the flag exists to skip. It fails with \"No test suite found\", nowhere near the cause, and only on Linux: npm uses cmd.exe on Windows, which does not glob, so this stays invisible to local runs. Verified on both shells.",
    "test": "vitest run --exclude 'submission/**'",
    "typecheck": "tsc -p tsconfig.json",
    "mirror:refresh": "node submission/refresh-mirror-manifest.mjs --write",
    "mirror:check": "node submission/refresh-mirror-manifest.mjs"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "n8n-workflow": "*",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
