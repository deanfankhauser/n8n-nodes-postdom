{
  "name": "n8n-nodes-postdom",
  "version": "0.2.0",
  "description": "n8n community node for Postdom — agent-led short-form video publishing, bounded plans, and performance measurement.",
  "keywords": [
    "n8n-community-node-package",
    "postdom",
    "short-form video",
    "social media",
    "tiktok",
    "instagram",
    "youtube"
  ],
  "license": "MIT",
  "homepage": "https://postdom.com",
  "author": {
    "name": "Postdom",
    "email": "hello@postdom.com",
    "url": "https://postdom.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deanfankhauser/n8n-nodes-postdom.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/PostdomApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Postdom/Postdom.node.js",
      "dist/nodes/PostdomTrigger/PostdomTrigger.node.js"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-icons.mjs",
    "lint": "eslint credentials nodes test",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "n8n-workflow": "*",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
